<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- RECORD_AUDIO: Sound Nebula (index.html/script.js) uses the mic
         for its audio-reactive visuals, and Video Production
         (video-production-app.js) requests it separately from the camera
         to record synchronised audio into Takes (mutable via the Mic
         volume slider, or skippable by denying the prompt). Android
         permissions aren't page-scoped, so this one declaration covers
         both — Property Colour Reference never touches it. See the
         privacy policy for the full breakdown. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.camera" android:required="true" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="true" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.SoundVisualiser.Launcher">

        <!--
          TWA wrapper: Chrome (as a Trusted Web Activity) does the actual
          rendering — this app is a thin native shell that launches the
          hosted PWA full-screen with no browser UI, verified via Digital
          Asset Links (assetlinks.json hosted on the same origin) so
          Chrome trusts it enough to hide the address bar entirely.
        -->
        <meta-data android:name="asset_statements" android:resource="@string/asset_statements" />

        <activity
            android:name="com.google.androidbrowserhelper.trusted.LauncherActivity"
            android:label="@string/app_name"
            android:theme="@style/Theme.SoundVisualiser.Launcher"
            android:exported="true">

            <meta-data
                android:name="android.support.customtabs.trusted.DEFAULT_URL"
                android:value="@string/launch_url" />
            <meta-data
                android:name="android.support.customtabs.trusted.STATUS_BAR_COLOR"
                android:resource="@color/colorPrimary" />
            <meta-data
                android:name="android.support.customtabs.trusted.NAVIGATION_BAR_COLOR"
                android:resource="@color/colorPrimary" />
            <meta-data
                android:name="android.support.customtabs.trusted.SPLASH_IMAGE_DRAWABLE"
                android:resource="@mipmap/ic_launcher" />
            <meta-data
                android:name="android.support.customtabs.trusted.SPLASH_SCREEN_BACKGROUND_COLOR"
                android:resource="@color/colorPrimary" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- autoVerify requires the target origin to host
                 /.well-known/assetlinks.json listing this app's package
                 name + signing certificate SHA-256 fingerprint (that file
                 covers the whole origin — the exclusion of Colour Vision
                 Extreme/Colour Assist/Viewer/Tutorials happens here
                 instead, via explicit per-page <data> entries rather than
                 a blanket pathPrefix over the whole site). Following a
                 link to one of those pages from inside the app still
                 works — Chrome just falls back to showing its normal
                 address bar for that page, since it isn't in this list. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="@string/host_name" android:path="@string/path_root" />
                <data android:scheme="https" android:host="@string/host_name" android:path="@string/path_index" />
                <data android:scheme="https" android:host="@string/host_name" android:path="@string/path_restore" />
                <data android:scheme="https" android:host="@string/host_name" android:path="@string/path_video_production" />
            </intent-filter>
        </activity>

        <!-- Delegates Chrome's own trusted-web-activity notifications
             through this app's identity, so notifications from the PWA
             (if it ever uses the Web Notifications API) look native. -->
        <service
            android:name="com.google.androidbrowserhelper.trusted.DelegationService"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.support.customtabs.trusted.TRUSTED_WEB_ACTIVITY_NOTIFICATION" />
            </intent-filter>
        </service>
    </application>
</manifest>
